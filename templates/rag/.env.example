PG_URL=postgres://rag:rag@localhost:5433/rag
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# Backend de embeddings (subproyecto F, Bloque 2):
#   ollama  -> Ollama local (por defecto)
#   remote  -> Ollama en otra máquina de la red; solo cambia OLLAMA_URL arriba
#              (p.ej. OLLAMA_URL=http://192.168.1.50:11434), sin código adicional
#   kaggle  -> lotes grandes en una GPU T4 gratuita; SOLO para ingest/reindex, nunca
#              para query (rag.mjs cae a ollama automáticamente y avisa una vez)
EMBED_BACKEND=ollama

# --- Kaggle (opcional, solo si usas EMBED_BACKEND=kaggle o `ingest --backend kaggle`) ---
# Crea un token en https://www.kaggle.com/settings -> API -> Create New Token.
# El instalador (rag.sh) las escribe aquí solo si ya las tenías en el entorno; si las
# dejas vacías, Kaggle simplemente no se usa.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_KERNEL_SLUG=
